{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/auth/layout,_N_T_/auth/unauthorized/layout,_N_T_/auth/unauthorized/page,_N_T_/auth/unauthorized"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/auth/unauthorized/__PAGE__",
    "/auth/unauthorized",
    "/auth",
    "/_index",
    "/_head"
  ]
}