{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/formations/[slug]",
      "regex": "^/api/formations/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/formations/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/templates/[id]",
      "regex": "^/api/templates/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/templates/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/templates/[id]/fields",
      "regex": "^/api/templates/([^/]+?)/fields(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/templates/(?<nxtPid>[^/]+?)/fields(?:/)?$"
    },
    {
      "page": "/api/templates/[id]/fields/[fieldId]",
      "regex": "^/api/templates/([^/]+?)/fields/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPfieldId": "nxtPfieldId"
      },
      "namedRegex": "^/api/templates/(?<nxtPid>[^/]+?)/fields/(?<nxtPfieldId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/formations/category/[slug]",
      "regex": "^/formations/category/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
