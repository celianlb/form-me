// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ENUMS
 */
enum UserRole {
  CLIENT
  ADMIN
  LEARNER
}

enum RequestProfile {
  INDIVIDUAL
  PROFESSIONAL
}

enum TrainingMode {
  PARTNER_CENTER
  E_LEARNING
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GroupMemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum InviteTokenType {
  SET_PASSWORD
  RESET_PASSWORD
}

/**
 * USERS
 */
model User {
  id           Int      @id @default(autoincrement())
  role         UserRole @default(CLIENT)
  firstName    String?
  lastName     String?
  email        String   @unique
  phone        String?
  address      String?
  postalCode   String?
  city         String?
  passwordHash String?
  mustChangePassword Boolean @default(false) // pour forcer le changement à la première connexion
  lastLoginAt    DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Relations
  trainingsCreated Training[] @relation("TrainingCreatedBy")
  trainingsUpdated Training[] @relation("TrainingUpdatedBy")

  // ✅ deux relations différentes vers AccessSupport
  accessReceived AccessSupport[] @relation("AccessSupportUser") // quand il est bénéficiaire
  accessGranted  AccessSupport[] @relation("AccessGrantedBy") // quand il est admin

  supportGroupMemberships SupportGroupMember[]
  supportGroupsCreated    SupportGroup[]       @relation("SupportGroupCreatedBy")
  inviteTokens            InviteToken[]
}

/**
 * CATEGORIES
 */
model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?

  trainings Training[]
}

model Training {
  id         Int    @id @default(autoincrement())
  categoryId Int
  title      String
  slug       String @unique

  shortDescription String? // tagline
  longDescription  String? // définition globale

  durationHours   Int?
  durationDays    Int? // NEW: ex: 1 jour
  minParticipants Int?     @default(1)
  maxParticipants Int?
  successRate     Decimal? @db.Decimal(5, 2)

  targetAudience String? // public concerné

  learningObjectives String? // version texte brut/markdown
  // Alternative: relation TrainingObjective[]

  prerequisites         String?
  technicalMeans        String?
  teachingMeans         String? // méthodes pédagogiques
  evaluationMethods     String?
  validationMethod      String?
  monitoringMethods     String? // NEW: suivi (émargement, évaluation, etc.)
  renewalRecommendation String? // NEW: conseils de renouvellement

  priceExclTax       Decimal?      @db.Decimal(10, 2)
  availableInCenter  Boolean       @default(true)
  availableElearning Boolean       @default(false)
  isActive           Boolean       @default(true)
  status             ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  createdById Int?
  updatedById Int?

  category  Category @relation(fields: [categoryId], references: [id])
  createdBy User?    @relation("TrainingCreatedBy", fields: [createdById], references: [id])
  updatedBy User?    @relation("TrainingUpdatedBy", fields: [updatedById], references: [id])

  modules       TrainingModule[]
  supports      Support[]
  supportGroups SupportGroup[]
  quotes        Quote[]
  versions      TrainingVersion[]
  objectives    TrainingObjective[]
}

model TrainingModule {
  id         Int     @id @default(autoincrement())
  trainingId Int
  title      String
  order      Int
  type       String? // NEW: "THEORETICAL" | "PRACTICAL"
  content    String? // liste détaillée, markdown

  training Training @relation(fields: [trainingId], references: [id])

  @@unique([trainingId, order])
}

model TrainingObjective {
  id         Int    @id @default(autoincrement())
  trainingId Int
  text       String

  training Training @relation(fields: [trainingId], references: [id])
}

/**
 * SUPPORTS
 */
model Support {
  id          Int      @id @default(autoincrement())
  trainingId  Int
  type        String // pdf, ppt, video, link…
  title       String
  description String?
  fileUrl     String
  fileSize    BigInt?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  training Training        @relation(fields: [trainingId], references: [id])
  access   AccessSupport[]
}

/**
 * ACCESS TO SUPPORTS (manual)
 */
model AccessSupport {
  id               Int       @id @default(autoincrement())
  userId           Int
  supportId        Int
  grantedByAdminId Int
  grantedAt        DateTime  @default(now())
  expiresAt        DateTime?

  // ✅ relations nommées
  user      User    @relation("AccessSupportUser", fields: [userId], references: [id])
  support   Support @relation(fields: [supportId], references: [id])
  grantedBy User    @relation("AccessGrantedBy", fields: [grantedByAdminId], references: [id])

  @@unique([userId, supportId])
}

/**
 * SUPPORT GROUPS (per training session, managed manually)
 */
model SupportGroup {
  id           Int       @id @default(autoincrement())
  trainingId   Int
  name         String
  companyName  String    // nom de l'entreprise
  trainingDate DateTime  // date à laquelle s'est effectuée la formation
  startDate    DateTime? // optional
  endDate      DateTime? // optional
  createdById  Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  training  Training @relation(fields: [trainingId], references: [id])
  createdBy User?    @relation("SupportGroupCreatedBy", fields: [createdById], references: [id]) // ✅ correction

  members SupportGroupMember[]
}

model SupportGroupMember {
  id         Int               @id @default(autoincrement())
  groupId    Int
  userId     Int
  status     GroupMemberStatus @default(INVITED)
  invitedAt  DateTime          @default(now())
  acceptedAt DateTime?

  group SupportGroup @relation(fields: [groupId], references: [id])
  user  User         @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

/**
 * INVITATIONS
 */
model InviteToken {
  id         Int             @id @default(autoincrement())
  userId     Int
  token      String          @unique
  type       InviteTokenType @default(SET_PASSWORD)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])
}

/**
 * QUOTES
 */
model Quote {
  id         Int            @id @default(autoincrement())
  firstName  String
  lastName   String?
  email      String
  phone      String?
  profile    RequestProfile
  address    String?
  postalCode String?
  city       String?

  trainingId     Int?
  mode           TrainingMode?
  numberLearners Int
  preferredDates String?
  message        String?
  source         String?
  status         String        @default("received") // received / processed / archived
  createdAt      DateTime      @default(now())

  training Training? @relation(fields: [trainingId], references: [id])
}

/**
 * VERSIONING
 */
model TrainingVersion {
  id         Int      @id @default(autoincrement())
  trainingId Int
  snapshot   Json
  savedAt    DateTime @default(now())
  savedBy    Int?

  training Training @relation(fields: [trainingId], references: [id])
}
