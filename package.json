{
  "name": "form-me",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@form-me/web",
    "dev:admin": "turbo dev --filter=@form-me/admin",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @form-me/database db:generate",
    "db:push": "pnpm --filter @form-me/database db:push",
    "db:migrate": "pnpm --filter @form-me/database db:migrate",
    "db:seed": "pnpm --filter @form-me/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
